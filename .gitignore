# ===========================
# GuideMe-NEU — Root .gitignore
# ===========================

# Node dependencies
node_modules/
client/node_modules/

# Build output
dist/
dist-ssr/
client/dist/
client/dist-ssr/

# Environment & Secrets — NEVER commit these
*.env
.env
.env.*
*.pem
*.key
*.crt
*.p12
*.p8
secrets/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor & OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Obsidian workspace settings
.obsidian/

# Misc
*.local
coverage/
.cache/
